# syntax=docker/dockerfile:1
# Image สำหรับ development (ใช้กับ compose.yaml) ส่วน Dockerfile เป็นของ production
ARG RUBY_VERSION=4.0.9
ARG NODE_VERSION=26.13.0
ARG BUN_VERSION=1.3.14

FROM docker.io/library/node:${NODE_VERSION}-slim AS node
FROM docker.io/oven/bun:${BUN_VERSION}-slim AS bun

FROM docker.io/library/ruby:${RUBY_VERSION}-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev libyaml-dev pkg-config \
      postgresql-client libvips curl && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Node + Yarn (esbuild) และ Bun (Tailwind) เวอร์ชันเดียวกับ mise.toml / README
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    npm install -g yarn@1.22.22
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s bun /usr/local/bin/bunx && gem install foreman

WORKDIR /rails

ENTRYPOINT ["bin/docker-dev-entrypoint"]
CMD ["bin/dev"]
