<main class="page">
  <h1>จัดการหนังสือ — Admin</h1>
  <div class="actions">
    <%= link_to "เพิ่มหนังสือ", new_book_path %>
    <%= link_to "จัดการหมวดหมู่", categories_path %>
    <%= link_to "จัดการร้าน", markets_path %>
    <%= link_to "สร้างผู้ใช้", new_user_path %>
    <%= link_to "กลับหน้ารายการ", books_path %>
  </div>

  <% @books.each do |book| %>
    <article class="book">
      <h2><%= link_to book.title, book_path(book) %></h2>
      <p>หมวดหมู่: <%= book.category.name %></p>
      <%= render "books/actions", book: book %>
    </article>
  <% end %>

  <% if @books.empty? %>
    <p>ยังไม่มีหนังสือ</p>
  <% end %>
</main>
