<% content_for :title, "เข้าสู่ระบบ | Book Store" %>

<main class="login">
  <h1>เข้าสู่ระบบ Book Store</h1>

  <%= tag.p flash[:alert], role: "alert", class: "alert" if flash[:alert] %>
  <%= tag.p flash[:notice], role: "status", class: "notice" if flash[:notice] %>

  <%= form_with url: session_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "อีเมล" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>

    <div class="field">
      <%= form.label :password, "รหัสผ่าน" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>

    <%= form.submit "เข้าสู่ระบบ", data: { turbo_submits_with: "กำลังเข้าสู่ระบบ…" } %>
  <% end %>

  <%= link_to "กลับหน้าหนังสือ", root_path %>
</main>
