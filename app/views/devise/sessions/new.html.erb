<% content_for :title, "เข้าสู่ระบบ | Book Store" %>

<main class="login">
  <h1>เข้าสู่ระบบ Book Store</h1>

  <%= tag.p flash[:alert], role: "alert", class: "alert" if flash[:alert] %>
  <%= tag.p flash[:notice], role: "status", class: "notice" if flash[:notice] %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field">
      <%= f.label :email, "อีเมล" %>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "username" %>
    </div>

    <div class="field">
      <%= f.label :password, "รหัสผ่าน" %>
      <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field checkbox">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "จดจำการเข้าสู่ระบบ" %>
      </div>
    <% end %>

    <%= f.submit "เข้าสู่ระบบ", data: { turbo_submits_with: "กำลังเข้าสู่ระบบ…" } %>
  <% end %>

  <%= render "devise/shared/links" %>
</main>
