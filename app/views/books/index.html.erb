<main class="page">
  <h1>หนังสือทั้งหมด</h1>
  <%= tag.p flash[:notice], class: "notice", role: "status" if flash[:notice] %>

  <nav aria-label="บัญชีผู้ใช้">
    <% if authenticated? %>
      <p><%= Current.user.email_address %></p>
      <% if Current.user.admin? %>
        <%= link_to "หน้าจัดการ Admin", admin_path %>
        <%= link_to "เพิ่มหนังสือ", new_book_path %>
      <% end %>
      <%= button_to "ออกจากระบบ", session_path, method: :delete %>
    <% else %>
      <%= link_to "เข้าสู่ระบบ", new_session_path %>
    <% end %>
  </nav>

  <%= form_with url: books_path, method: :get do |form| %>
    <%= form.hidden_field :category_id, value: @category_id if @category_id %>
    <div class="field">
      <%= form.label :q, "ค้นหาชื่อหนังสือ" %>
      <%= form.search_field :q, value: @query %>
    </div>
    <%= form.submit "ค้นหา" %>
  <% end %>

  <nav class="categories" aria-label="หมวดหมู่หนังสือ">
    <%= link_to "ทั้งหมด", books_path(q: @query.presence),
          class: "category", aria: { current: @category_id.nil? ? "page" : nil } %>
    <% @categories.each do |category| %>
      <%= link_to category.name, books_path(category_id: category.id, q: @query.presence),
            class: "category", aria: { current: @category_id == category.id.to_s ? "page" : nil } %>
    <% end %>
  </nav>

  <% @books.each do |book| %>
    <article class="book">
      <h2><%= link_to book.title, book_path(book) %></h2>
      <p>ผู้เขียน: <%= book.author %></p>
      <p>ราคา: <%= number_to_currency(book.price, unit: "฿") %></p>
    </article>
  <% end %>

  <% if @books.empty? %>
    <p>ไม่พบหนังสือ</p>
  <% end %>
</main>
