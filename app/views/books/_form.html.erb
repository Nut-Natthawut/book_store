<%= form_with model: book do |form| %>
  <% if book.errors.any? %>
    <div class="alert" role="alert">
      <p>บันทึกไม่ได้ กรุณาตรวจสอบข้อมูล:</p>
      <ul>
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, "ชื่อหนังสือ" %>
    <%= form.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= form.label :author, "ผู้เขียน" %>
    <%= form.text_field :author, required: true %>
  </div>

  <div class="field">
    <%= form.label :description, "รายละเอียด" %>
    <%= form.text_area :description, rows: 5, required: true %>
  </div>

  <div class="field">
    <%= form.label :price, "ราคา (บาท)" %>
    <%= form.number_field :price, min: 0.01, step: 0.01, required: true %>
  </div>

  <div class="field">
    <%= form.label :category_id, "หมวดหมู่" %>
    <%= form.collection_select :category_id, @categories, :id, :name, { prompt: "เลือกหมวดหมู่" }, { required: true } %>
  </div>

  <fieldset class="market-selection">
    <legend>ร้านที่มีหนังสือเล่มนี้ (เลือกได้หลายร้าน)</legend>
    <%= form.collection_check_boxes :market_ids, @markets, :id, :name do |option| %>
      <%= option.label class: "market-option" do %>
        <%= option.check_box %>
        <%= option.text %>
      <% end %>
    <% end %>
    <% if @markets.empty? %>
      <p>ยังไม่มีร้าน <%= link_to "เพิ่มร้าน", new_market_path %></p>
    <% end %>
  </fieldset>

  <%= form.submit "บันทึก", data: { turbo_submits_with: "กำลังบันทึก…" } %>
<% end %>
