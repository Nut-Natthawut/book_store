<main class="page">
  <h1><%= @book.title %></h1>
  <%= tag.p flash[:notice], class: "notice", role: "status" if flash[:notice] %>
  <p>ผู้เขียน: <%= @book.author %></p>
  <p>หมวดหมู่: <%= @book.category.name %></p>
  <p><%= @book.description %></p>
  <p>ราคา: <%= number_to_currency(@book.price, unit: "฿") %></p>
  <h2>ร้านที่มีหนังสือเล่มนี้</h2>
  <% @book.markets.each do |market| %>
    <p><%= market.name %></p>
  <% end %>
  <% if @book.markets.empty? %>
    <p>ยังไม่ได้ระบุร้าน</p>
  <% end %>
  <% if authenticated? && Current.user.admin? %>
    <%= render "actions", book: @book %>
  <% end %>
  <%= link_to "กลับหน้ารายการ", root_path %>
</main>
